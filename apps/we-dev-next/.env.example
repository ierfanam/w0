# Free model providers
# Zhipu GLM free models
ZHIPU_API_KEY=

# OpenRouter free model catalog/router
OPENROUTER_API_KEY=

# Public URL used by OpenRouter metadata
APP_BASE_URL=http://localhost:3000

# Legacy third-party provider settings (optional; not required for free models)
THIRD_API_URL=
THIRD_API_KEY=

# JWT secret key (optional)
JWT_SECRET=

# MongoDB connection string (optional)
MONGODB_URI=

# ScreenshotOne API key for landing page screenshots (optional)
SCREENSHOTONE_API_KEY=
